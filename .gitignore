# Temporary directories
$tempDir/
.claude/
.tmp.driveupload/

# Large binary assets
BSA/
Image/
mod/
Launcher/
バイナリ/

# Game data and extracted assets (property of Bethesda Game Studios / ZENiMax Media).
# This project follows a BYO-data model: game data is never redistributed.
*.bsa
*.esm
*.esp
# Synthetic chargen smoke fixture: generated by
# tools/host_tests/make_fixture_esm.py and containing no Bethesda data, so it is
# safe to commit (unlike the *.esm rule above). Must stay after that rule.
!docs/evidence/fixtures/*.esm
*.nif
*.kf
*.dds
*.lip
*.egm
*.scc

# Synthetic fixture exception (same reasoning as the *.esm rule above): these are
# self-authored byte sequences produced by tools/host_tests/make_fixture_*.py and
# contain no Bethesda data, so they are safe to commit. Must stay after the
# data-extension rules.
!docs/evidence/fixtures/*.dds
!docs/evidence/fixtures/*.nif
!docs/evidence/fixtures/*.bsa

# 実物 NIF の被覆 fixture（docs/evidence/fixtures/nif/）。Oblivion - Meshes.bsa の
# 最小抜粋で、型被覆のためだけに置く（上の合成 fixture とは別系統）。ゲーム資産
# 本体は含まない。*.nif はサブディレクトリにも効くので ** で再包含する。
!docs/evidence/fixtures/nif/**/*.nif
*.lod
textures_extracted/
meshes_extracted/
sounds_extracted/
tools/BSAFileExtractor/

# Bethesda assets kept locally for testing only; never redistribute.
# Local builds still package these from disk. A fresh clone will render the
# title screen without them (all texture uses are guarded by != 0).
app/src/main/assets/videos/
app/src/main/assets/textures/ui/loading_background.png
app/src/main/assets/textures/ui/load_in_game_default.png
app/src/main/assets/textures/ui/loading_symbol.png
app/src/main/assets/textures/ui/tes_oblivion_logo_bink.png
app/src/main/assets/textures/ui/tes_oblivion_logo_final.png
app/src/main/assets/textures/ui/dialog_selection_cut.png
app/src/main/assets/textures/ui/dialog_selection_full.png
app/src/main/assets/textures/ui/oblivion_crest.png
app/src/main/assets/textures/ui/stat_skill_level_ribbon_empty.png
app/src/main/assets/textures/ui/stat_skill_level_ribbon_full.png
app/src/main/assets/textures/ui/stat_skill_level_ribbon_slider.png

# Debug screenshots and XML dumps (root directory)
/*.png
/*.xml

# Local debug screenshots moved out of the repo root. Kept on disk for
# reference only; never redistributed or uploaded.
/screenshots/

# Repo-root scratch area for temporary files (build logs, UI dumps, local
# APK output). Local-only; never uploaded.
# Exception (2026-11-10, human ruling #64): the Graphify RE corpus must be able
# to scan tmp/re ruling artifacts. Only v*.md rulings are re-included; everything
# else in the scratch area (ledger, .bakNNN copies, n5b_samples binaries, probe
# scripts) stays ignored. Note: a bare `/tmp/` exclusion can never be re-included
# by negation (git does not descend into excluded directories), so the exclusion
# uses the content form `/tmp/*` plus the re-include chain below.
/tmp/*
!/tmp/re/
/tmp/re/*
!/tmp/re/v*.md

# Keystore (sensitive)
*.keystore

# Legacy Kotlin DSL gradle files (Groovy DSL is the single source of truth)
*.gradle.kts

# Gradle files
.gradle/
build/
*.apk
*.aar

# Build artifacts
*.o
*.obj
*.so
*.dll
*.exe
app/build/
external/

# Host test scratch output (tools/host_tests/run_host_tests.sh)
host_saves/

# Smoke test output (docs/smoke-tests/*.sh writes screenshots and logcat dumps here)
/artifacts/

# Repo-root scratch: local build/launch logs and the local game-data pull.
# oblivion_esm_pull/ holds the real Oblivion.esm used for offline verification;
# it is data, not source, and must never be committed (BYO-data model).
buildlog_*.txt
launch_out.txt
oblivion_esm_pull/

# Jolt Physics vendored build scripts must stay tracked for CI (Build/ is NOT
# an output directory; the generic build/ rule above would ignore it).
!app/src/main/cpp/third_party/JoltPhysics/Build/
!app/src/main/cpp/third_party/JoltPhysics/Build/**

