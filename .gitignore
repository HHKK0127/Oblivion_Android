# Temporary directories
$tempDir/
.claude/
.tmp.driveupload/

# Large binary assets
BSA/
Image/
mod/
Launcher/
バイナリ/

# Game data and extracted assets (property of Bethesda Game Studios / ZENiMax Media).
# This project follows a BYO-data model: game data is never redistributed.
*.bsa
*.esm
*.esp
*.nif
*.kf
*.dds
*.lip
*.egm
*.scc
*.lod
textures_extracted/
meshes_extracted/
sounds_extracted/
tools/BSAFileExtractor/

# Bethesda assets kept locally for testing only; never redistribute.
# Local builds still package these from disk. A fresh clone will render the
# title screen without them (all texture uses are guarded by != 0).
app/src/main/assets/videos/
app/src/main/assets/textures/ui/loading_background.png
app/src/main/assets/textures/ui/load_in_game_default.png
app/src/main/assets/textures/ui/loading_symbol.png
app/src/main/assets/textures/ui/tes_oblivion_logo_bink.png
app/src/main/assets/textures/ui/tes_oblivion_logo_final.png
app/src/main/assets/textures/ui/dialog_selection_cut.png
app/src/main/assets/textures/ui/dialog_selection_full.png
app/src/main/assets/textures/ui/oblivion_crest.png

# Debug screenshots and XML dumps (root directory)
/*.png
/*.xml

# Keystore (sensitive)
*.keystore

# Legacy Kotlin DSL gradle files (Groovy DSL is the single source of truth)
*.gradle.kts

# Gradle files
.gradle/
build/
*.apk
*.aar

# Build artifacts
*.o
*.obj
*.so
*.dll
*.exe
app/build/
external/

# Host test scratch output (tools/host_tests/run_host_tests.sh)
host_saves/

# Repo-root scratch: local build/launch logs and the local game-data pull.
# oblivion_esm_pull/ holds the real Oblivion.esm used for offline verification;
# it is data, not source, and must never be committed (BYO-data model).
buildlog_*.txt
launch_out.txt
oblivion_esm_pull/

# Jolt Physics vendored build scripts must stay tracked for CI (Build/ is NOT
# an output directory; the generic build/ rule above would ignore it).
!app/src/main/cpp/third_party/JoltPhysics/Build/
!app/src/main/cpp/third_party/JoltPhysics/Build/**

# Android Studio
.idea/
*.iml
*.iws
*.ipr
local.properties

# CMake
cmake-build-debug/
cmake-build-release/
app/src/main/cpp/.cxx/
app/.cxx/

# IDE files
.vscode/
.clion*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Python cache
__pycache__/
*.pyc

# Logs
*.log
*.tmp
