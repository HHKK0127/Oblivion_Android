<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- GLSurfaceView for OpenGL ES rendering -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Debug Overlay Container -->
    <FrameLayout
        android:id="@+id/debug_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Overlay Background (semi-transparent) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000" />

        <!-- Debug Panel - Left side -->
        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:layout_gravity="top|start"
            android:layout_marginStart="10dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="10dp"
            android:background="#CC222222"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Debug Control Panel"
                android:textColor="#00BFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <!-- Scrollable Content -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/debug_button_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="top">

                    <!-- Section: Toggles -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TOGGLES"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp" />

                    <Button
                        android:id="@+id/btn_debug_console"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Debug Console"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#33444444"
                        android:textColor="#CCCCCC" />

                    <Button
                        android:id="@+id/btn_debug_npc"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="NPC Debug"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#33444444"
                        android:textColor="#CCCCCC" />

                    <Button
                        android:id="@+id/btn_debug_world"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="World Debug"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#33444444"
                        android:textColor="#CCCCCC" />

                    <Button
                        android:id="@+id/btn_debug_perf"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Performance Graph"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#33444444"
                        android:textColor="#CCCCCC" />

                    <Button
                        android:id="@+id/btn_debug_all"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Toggle All Systems"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#33444444"
                        android:textColor="#CCCCCC" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#444444"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <!-- Section: Debug Menu -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DEBUG MENU"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingBottom="2dp" />

                    <Button
                        android:id="@+id/btn_debug_menu"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Open Debug Menu"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#332266"
                        android:textColor="#00BFFF" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#444444"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp" />

                    <!-- Section: Quick Actions -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="QUICK ACTIONS"
                        android:textColor="#888888"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingBottom="2dp" />

                    <Button
                        android:id="@+id/btn_debug_heal"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Heal Player"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#334433"
                        android:textColor="#66FF66" />

                    <Button
                        android:id="@+id/btn_debug_killall"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Kill All NPCs"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#443333"
                        android:textColor="#FF6666" />

                    <Button
                        android:id="@+id/btn_debug_fly"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Toggle God Mode"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#334433"
                        android:textColor="#66FF66" />

                    <Button
                        android:id="@+id/btn_debug_noclip"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="Toggle No Clip"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        android:background="#334444"
                        android:textColor="#66FFFF" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close_debug"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="10dp"
            android:text="X"
            android:textSize="14sp"
            android:background="#FF5555"
            android:textColor="#FFFFFF"
            android:elevation="10dp" />

    </FrameLayout>

    <!-- Debug Toggle Button - Top-left corner -->
    <Button
        android:id="@+id/btn_debug_toggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="D"
        android:textSize="12sp"
        android:background="#333333"
        android:textColor="#FFFFFF"
        android:alpha="0.7"
        android:elevation="10dp" />

</FrameLayout>
